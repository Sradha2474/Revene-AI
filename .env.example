# Revene — environment template (copy to .env and fill)
# NEVER commit real .env to GitHub

# development | production
APP_ENV=development

# Razorpay Test Mode (Dashboard → Settings → API Keys → Test Mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx

# Required in APP_ENV=production (from Razorpay Webhook settings)
# RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Dev-only: allow unsigned webhooks (NEVER in production)
# RAZORPAY_WEBHOOK_ALLOW_UNSIGNED=1

# Server
HOST=0.0.0.0
PORT=5000
LOG_LEVEL=INFO

# CORS: * for local demo, or comma-separated origins in production
# CORS_ORIGINS=https://your-domain.com

# Optional API key for mutating routes (leave off so HTML demo keeps working)
# REQUIRE_API_KEY=1
# API_KEY=change-me-long-random

# Live fake checkout stream (default ON — set 0 for webhook-only worker)
# ENABLE_LIVE_SIMULATOR=1

# Policy bounds — AI recommends, policy decides
# POLICY_MAX_RETRIES=2
# POLICY_AUTO_MAX_AMOUNT=5000
# POLICY_HUMAN_AMOUNT=10000
# POLICY_MIN_PROBABILITY_AUTO=0.80
